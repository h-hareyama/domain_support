{
  "name": "domain-support-modern",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vue-tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:api": "tsx watch api/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test api/*.test.ts",
    "test:browser": "node --import tsx --test web/*.test.ts",
    "build:api": "tsc -p tsconfig.build.json",
    "start:api": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "vue": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
