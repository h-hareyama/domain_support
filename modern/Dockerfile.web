FROM node:24-alpine AS build
WORKDIR /app/modern
COPY modern/package*.json ./
RUN npm ci
COPY modern/web ./web
COPY modern/api/schema.ts ./api/schema.ts
COPY css /app/css
RUN npm run build:web

FROM nginx:1.27-alpine
COPY modern/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/modern/dist/web /usr/share/nginx/html
